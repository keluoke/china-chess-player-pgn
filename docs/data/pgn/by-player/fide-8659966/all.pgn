			position: absolute;
			top: 137px;
			left: 0;
			background: rgb(245, 246, 246);
			box-shadow: #ccc;
			width: 100%;
			box-shadow: 0 4px 2px -2px rgba(36, 36, 36, 0.17);
			left: -200%;
			transition: all 0.4s ease;
			z-index: 10000 !important;
	}
	.mobile-menu-container.open-menu {
			left: 0;
	}
	.menu-burger {
			position: absolute;
			right: 10px;
			top: 69px;
			width: 24px;
			height: 19px;
			display: block;
			margin-left: auto;
			margin-bottom: 20px;
			cursor: pointer;
	}
	.menu-burger span, .menu-burger:after, .menu-burger:before{
			height: 3px;
			width: 100%;
			position: absolute;
			background: #24305E;
			margin: 0 auto;
			border-radius: 1px;
	}
	.menu-burger span{
			top: 21px;
	}
	.menu-burger:after, .menu-burger:before{
			content: '';
	}
	.menu-burger:after{
			bottom: 3px;
			border-radius: 1px;
	}
	.menu-burger:before{
			top: 5px;
			border-radius: 1px;
	}
	.menu-burger.open-menu span {
			transform: rotate(38deg);
			top: 8px;
			transition: 0.4s;
	}
	.menu-burger.open-menu:before {
			opacity:0;
			transition: 0.5s;
	}
	.menu-burger.open-menu:after {
			transform: rotate(-38deg);
			bottom: 8px;
			transition: 0.4s;
	}
	.social {
			position: absolute;
			top: 10px;
			left: 159px;
			width: 400px;
			justify-content: space-between;
	}
